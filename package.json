{
  "name": "financial-analytics-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "scripts": {
    "build": "tsc --build packages/frontend/api && vite build apps/web",
    "format": "prettier --write \"apps/web/**/*.{html,json,ts,tsx,css}\" \"packages/frontend/**/*.{json,ts}\" \"tests/e2e/**/*.{json,ts}\" \"*.{js,json,ts,yaml}\" \"infra/docker/web/*.mjs\"",
    "format:check": "prettier --check \"apps/web/**/*.{html,json,ts,tsx,css}\" \"packages/frontend/**/*.{json,ts}\" \"tests/e2e/**/*.{json,ts}\" \"*.{js,json,ts,yaml}\" \"infra/docker/web/*.mjs\"",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --no-shell chromium",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "playwright": "1.64.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
