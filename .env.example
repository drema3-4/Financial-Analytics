# Copy this file to .env and fill secrets locally. Never commit .env.
APP_ENV=development
APP_VERSION=0.2.0
DEBUG=false
APP_TIMEZONE=UTC

POSTGRES_DB=financial_analytics
POSTGRES_USER=financial_analytics
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://financial_analytics:replace-with-a-local-development-password@localhost:5432/financial_analytics

# JSON array. Keep origins explicit; wildcard origins are rejected in every environment.
CORS_ORIGINS=["http://localhost:4173","http://127.0.0.1:4173"]
# Leave empty locally: use the page hostname on API port 8000. Set explicitly for production.
VITE_API_BASE_URL=
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:4173
BOOTSTRAP_MASTER_EMAIL=
TRUSTED_PROXY_IPS=[]

# Independent random values, at least 32 bytes each. Production rejects development defaults.
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-another-32-random-bytes
EMAIL_TOKEN_SECRET=replace-with-a-third-32-random-bytes
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=

LLM_PROVIDER=disabled
LLM_BASE_URL=http://vllm:8000/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-4B-AWQ
LLM_ENDPOINT_SCOPE=local
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_MAX_TOKENS=800
LLM_SUPPORTS_JSON_SCHEMA=true
LLM_SUPPORTS_SYSTEM_MESSAGES=true
LLM_SUPPORTS_NON_THINKING=true
VLLM_MAX_MODEL_LEN=2048
VLLM_MODEL_REVISION=74d4bd2bd4bff9cafc9345221320bffb08b406a3
VLLM_GPU_MEMORY_UTILIZATION=0.80

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_ADDRESS=no-reply@localhost
SMTP_SECURITY=plain
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
